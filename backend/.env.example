# Copy this file to ".env" and fill in your own values.
# The real .env file holds secrets and must never be shared or uploaded.

APP_NAME="Lead Intel"

# Where the database is. Laptop: a SQLite file (created automatically).
# Live server: Railway's PostgreSQL → DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="sqlite:///./data/leads.db"

# "development" on your laptop. The live server's Dockerfile sets "production",
# which refuses demo keys/accounts, hides /docs and adds security headers.
ENVIRONMENT="development"
SHOW_DOCS=false
SENTRY_DSN=""                       # optional error alerts (sentry.io)
BACKUP_DIR="./data/backups"         # nightly backups at 3am India time
BACKUP_KEEP_DAYS=14
# One-time on the live server: creates your admin login, then DELETE both
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# AI settings
# MOCK_AI=true  -> agents use built-in fake answers (free, no API key needed)
# MOCK_AI=false -> agents call Claude for real (needs ANTHROPIC_API_KEY)
MOCK_AI=true
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"          # smart model: weekly reports, strategy
AI_MODEL_FAST="claude-haiku-5-5"    # fast + cheap model: per-lead jobs (tone, score)
AI_TIMEOUT_SECONDS=60

# Secret word Meta sends when verifying a webhook (we invent this ourselves)
WEBHOOK_VERIFY_TOKEN="change-me"

# Address of the React dashboard, so the browser is allowed to call our API
FRONTEND_ORIGIN="http://localhost:5173"

# Scheduler: publishes scheduled posts on time and refreshes post numbers
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Subscriptions (Razorpay). Leave the keys empty for free MOCK payments
# (a "pretend pay" button: POST /billing/mock-pay). For real money:
#   1. razorpay.com → sign up → Dashboard → Account & Settings → API Keys (start with TEST mode keys)
#   2. Subscriptions → Plans → create 3 monthly plans (₹999, ₹2,499, ₹4,999) → paste their plan_... ids
#   3. Webhooks → add https://YOUR-DOMAIN/webhooks/razorpay, choose a secret, tick the subscription.* events
TRIAL_DAYS=14
PAYMENT_GRACE_DAYS=3
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
RAZORPAY_PLAN_PRO=""

# Security: CHANGE before going live. It locks the platform keys we store.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (If you change it later, every business must click Connect again.)
SECRET_KEY="dev-only-secret-change-me"
# This server's public https address (Meta/Google send owners back here, and ring the doorbells)
PUBLIC_API_URL="http://127.0.0.1:8000"

# Connecting real platforms. Leave empty for free MOCK connections.
# Meta (WhatsApp + Facebook Pages): developers.facebook.com → Create app (type: Business)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"
META_WHATSAPP_CONFIG_ID=""      # Facebook Login for Business → Configurations → WhatsApp Embedded Signup
META_PAGES_CONFIG_ID=""         # optional
# Instagram: same Meta app → Instagram → "API setup with Instagram login"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Google Business Profile: console.cloud.google.com → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
WHATSAPP_REVIEW_TEMPLATE="review_request"
WHATSAPP_PAYMENT_TEMPLATE="payment_reminder"   # Task 31: "a gentle reminder: ₹... is due" (created for you on WhatsApp connect)
REVIEWS_SYNC_MINUTES=30

# Uploaded photos and videos (served at PUBLIC_API_URL/files/...)
MEDIA_DIR="./data/media"
MAX_PHOTO_MB=15
MAX_VIDEO_MB=100

# Emails (password reset, welcome, trial reminders, receipts). Leave SMTP_HOST empty for MOCK
# mode: every email is saved as an .html file in data/outbox/ (open it in a browser).
# Real sending, e.g. Brevo (free 300/day): SMTP_HOST="smtp-relay.brevo.com", port 587,
# username + SMTP key from Brevo → SMTP & API. Verify your domain there (SPF/DKIM) so emails
# don't land in spam.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM="Lead Intel <hello@yourdomain.in>"
EMAIL_REPLY_TO=""
COMPANY_NAME="Lead Intel"          # your registered business name (receipts, legal pages)
COMPANY_GSTIN=""                   # only if you're GST-registered
# Shown on the public website (Contact, Terms, Privacy). Razorpay, Meta and Google check these pages.
COMPANY_ADDRESS=""                 # your registered / operating address in India
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
GRIEVANCE_OFFICER=""               # a real person's name (Indian privacy law)
GRIEVANCE_EMAIL=""
LEGAL_CITY="New Delhi"
POLICIES_UPDATED="18 October 2026" # change when you edit the legal pages
SITE_URL=""                        # the public website, e.g. https://leadintel.in
PASSWORD_RESET_MINUTES=60
TRIAL_REMINDER_DAYS=3

# Email lead reader (Justdial / Sulekha / Practo / IndiaMART lead emails).
# Each business gets leads-<secret>@INBOUND_EMAIL_DOMAIN. Use a subdomain of yours (e.g. in.yourdomain.in)
# with Cloudflare Email Routing + the worker in deploy/cloudflare-email-worker.js (free).
INBOUND_EMAIL_DOMAIN="in.example.com"
INBOUND_EMAIL_SECRET="change-me-inbound"   # long random text; the same value goes in the Cloudflare worker

# Hot-lead alerts to owners' phones (Task 28): Lead Intel's own WhatsApp number (optional; see DEPLOY.md)
ALERTS_WHATSAPP_PHONE_ID=
ALERTS_WHATSAPP_TOKEN=
